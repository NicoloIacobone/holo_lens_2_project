/holo_lens_2_project/[Ll]ibrary/
/holo_lens_2_project/[Tt]emp/
/holo_lens_2_project/[Oo]bj/
/holo_lens_2_project/[Bb]uild/
/holo_lens_2_project/[Bb]uilds/
/holo_lens_2_project/[Ll]ogs/
/holo_lens_2_project/[Uu]ser[Ss]ettings/
/holo_lens_2_project/[Mm]emoryCaptures/
/holo_lens_2_project/[Rr]ecordings/

# Auto-generated IDE / solution files
/holo_lens_2_project/.vs/
/holo_lens_2_project/.vscode/
/holo_lens_2_project/.idea/
/holo_lens_2_project/.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
