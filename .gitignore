*.pdb.meta
*.mdb.meta

# Unity crash reports / builds
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# ---------------------------------------------------------------
# Generated UWP / Visual Studio build output (IL2CPP)
# Re-create it from Unity: File > Build Settings > Universal Windows Platform > Build
# ---------------------------------------------------------------
/build/

# ---------------------------------------------------------------
# Signing certificates (contain a private key - never commit them)
# Unity can create a new test certificate:
# Project Settings > Player > Publishing Settings > Certificate > Create
# ---------------------------------------------------------------
*.pfx
*.pfx.meta

# ---------------------------------------------------------------
# Original full-size screen recording (a compressed copy is in docs/)
# ---------------------------------------------------------------
/DemoVideo.mp4

# Blender auto-backups
*.blend1
*.blend1.meta

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
